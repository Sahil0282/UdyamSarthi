# Agmarknet / data.gov.in — mandi prices (PART 3.2)
DATA_GOV_IN_API_KEY=

# LLM — narration ONLY (M7). System runs fully without it via --no-llm.
GEMINI_API_KEY=

# MongoDB — non-geospatial store: run logs, provenance, scheme rules,
# sector templates, cached API responses.
MONGO_DB_URL=
# The Atlas user needs the readWrite role on this database, not just dbAdmin.
MONGO_DB_NAME=udyam

# PostgreSQL + PostGIS — geospatial layer: village polygons, catchment
# buffers, spatial joins. Not substitutable by MongoDB.
PGHOST=localhost
PGPORT=5433
PGDATABASE=udyam
PGUSER=udyam
PGPASSWORD=udyam
